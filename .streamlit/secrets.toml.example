# .streamlit/secrets.toml
# Copiez ce contenu dans les 'Secrets' de votre application sur Streamlit Cloud.
# Ne committez JAMAIS ce fichier s'il contient des vrais mots de passe.

# Configuration des données : clé à la racine, avant les sections [auth]/[whoop].
# data_url = "https://docs.google.com/spreadsheets/d/YOUR_ID/export?format=csv"

# Configuration de l'authentification
[auth]
required = true
password = "super_secure_password"

# Intégration WHOOP (onglet "Whoop").
# Créez une application sur le tableau de bord développeur WHOOP, puis reportez ici
# les identifiants. La Redirect URI doit être déclarée à l'identique côté WHOOP.
# [whoop]
# client_id = "votre_client_id"
# client_secret = "votre_client_secret"
# redirect_uri = "https://votre-app.streamlit.app"
